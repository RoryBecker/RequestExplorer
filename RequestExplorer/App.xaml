<Application x:Class="RequestExplorer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="App.SurfaceBrush" Color="#FFF7F8FA" />
        <SolidColorBrush x:Key="App.PanelBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="App.BorderBrush" Color="#FFD8DEE6" />
        <SolidColorBrush x:Key="App.MutedBrush" Color="#FF6B7280" />
        <SolidColorBrush x:Key="App.AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="App.DangerBrush" Color="#FFDC2626" />
        <SolidColorBrush x:Key="App.WarnBrush" Color="#FFB45309" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="#FFEEF2FF" />
            <Setter Property="BorderBrush" Value="{StaticResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource App.AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource App.AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="#FFEFF2F6" />
            <Setter Property="Foreground" Value="{StaticResource App.MutedBrush}" />
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="#FFF7F8FA" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Application.Resources>
</Application>
