<Window x:Class="RequestExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RequestExplorer.ViewModels"
        xmlns:views="clr-namespace:RequestExplorer.Views"
        xmlns:conv="clr-namespace:RequestExplorer.Converters"
        mc:Ignorable="d"
        Title="RequestExplorer"
        Height="720"
        Width="1200"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:VerbToBrushConverter x:Key="VerbBrush" />
        <conv:TreeRowWidthConverter x:Key="TreeRowWidth" />

        <!-- ~50% lighter than accent blue for selection -->
        <SolidColorBrush x:Key="Tree.SelectionBrush" Color="#802563EB" />
        <SolidColorBrush x:Key="Tree.InactiveSelectionBrush" Color="#402563EB" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding AddCollectionCommand}" />
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding SendRequestCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateRequestCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameNodeCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteNodeCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _All" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Open collections _folder" Command="{Binding OpenStorageFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoMenuHeader}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{Binding RedoMenuHeader}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="New _Collection" Command="{Binding AddCollectionCommand}" InputGestureText="Ctrl+Shift+N" />
                <MenuItem Header="New _Folder" Command="{Binding AddFolderCommand}" />
                <MenuItem Header="New _Request" Command="{Binding AddRequestCommand}" />
                <MenuItem Header="_Duplicate Request" Command="{Binding DuplicateRequestCommand}" InputGestureText="Ctrl+D" />
                <Separator />
                <MenuItem Header="_Rename" Command="{Binding RenameNodeCommand}" InputGestureText="F2" />
                <MenuItem Header="_Delete" Command="{Binding DeleteNodeCommand}" InputGestureText="Del" />
            </MenuItem>
            <MenuItem Header="_Request">
                <MenuItem Header="_Send" Command="{Binding SendRequestCommand}" InputGestureText="Ctrl+Enter" />
                <MenuItem Header="_Cancel" Command="{Binding CancelSendCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About RequestExplorer" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionSummary}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StorageDirectory}"
                           ToolTip="Collections storage path"
                           Opacity="0.75"
                           FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{StaticResource App.SurfaceBrush}">
                <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource App.SurfaceBrush}">
                    <ToolBar Band="0" BandIndex="0" ToolBarTray.IsLocked="True">
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                ToolTip="Save collection (Ctrl+S)" />
                        <Separator />
                        <Button Content="Collection" Command="{Binding AddCollectionCommand}"
                                ToolTip="New collection (Ctrl+Shift+N)" />
                        <Button Content="Folder" Command="{Binding AddFolderCommand}"
                                ToolTip="New folder under selection" />
                        <Button Content="Request" Command="{Binding AddRequestCommand}"
                                ToolTip="New request under selection" />
                        <Separator />
                        <Button Content="Rename" Command="{Binding RenameNodeCommand}"
                                ToolTip="Rename (F2)" />
                        <Button Content="Delete" Command="{Binding DeleteNodeCommand}"
                                ToolTip="Delete (Del)" />
                    </ToolBar>
                </ToolBarTray>

                <TextBlock DockPanel.Dock="Top"
                           Margin="12,8,12,4"
                           Text="Collections"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.MutedBrush}" />

                <Grid>
                    <Border Margin="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCollections}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <TextBlock Text="No collections yet"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource App.MutedBrush}" />
                            <TextBlock Margin="0,8,0,12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource App.MutedBrush}"
                                       Text="Create a collection to start building requests." />
                            <Button Content="New Collection"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddCollectionCommand}" />
                        </StackPanel>
                    </Border>

                    <TreeView x:Name="CollectionTree"
                              Margin="4,0,4,8"
                              BorderThickness="0"
                              Background="Transparent"
                              ItemsSource="{Binding Collections}"
                              SelectedItemChanged="CollectionTree_OnSelectedItemChanged"
                              Visibility="{Binding HasCollections, Converter={StaticResource BoolToVis}}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="10,1,2,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <EventSetter Event="PreviewMouseDoubleClick" Handler="TreeViewItem_OnPreviewMouseDoubleClick" />
                                <Style.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                     Color="#802563EB" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                                     Color="#FF1F2937" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                                     Color="#402563EB" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                                     Color="#FF1F2937" />
                                </Style.Resources>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                                <MenuItem Header="Save All" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                                <Separator />
                                <MenuItem Header="New Collection" Command="{Binding AddCollectionCommand}" />
                                <MenuItem Header="New Folder" Command="{Binding AddFolderCommand}" />
                                <MenuItem Header="New Request" Command="{Binding AddRequestCommand}" />
                                <MenuItem Header="Duplicate Request" Command="{Binding DuplicateRequestCommand}" InputGestureText="Ctrl+D" />
                                <Separator />
                                <MenuItem Header="Rename" Command="{Binding RenameNodeCommand}" InputGestureText="F2" />
                                <MenuItem Header="Delete" Command="{Binding DeleteNodeCommand}" InputGestureText="Del" />
                            </ContextMenu>
                        </TreeView.ContextMenu>

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:CollectionNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid x:Name="CollectionRow" MinHeight="22" Margin="0,1">
                                    <Grid.Width>
                                        <MultiBinding Converter="{StaticResource TreeRowWidth}">
                                            <Binding Path="ActualWidth" ElementName="CollectionTree" />
                                            <Binding RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </Grid.Width>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE8F1;"
                                                   Margin="0,0,6,0"
                                                   Foreground="{StaticResource App.AccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <Button Content="+"
                                                Style="{StaticResource TreeActionButton}"
                                                ToolTip="Add child"
                                                Click="TreeAddButton_OnClick" />
                                        <Button Content="-"
                                                Style="{StaticResource TreeActionButton}"
                                                Margin="4,0,0,0"
                                                ToolTip="Delete"
                                                Click="TreeDeleteButton_OnClick" />
                                        <Button Content="…"
                                                Style="{StaticResource TreeActionButton}"
                                                Margin="4,0,0,0"
                                                ToolTip="More actions"
                                                Click="TreeMoreButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid MinHeight="22" Margin="0,1">
                                    <Grid.Width>
                                        <MultiBinding Converter="{StaticResource TreeRowWidth}">
                                            <Binding Path="ActualWidth" ElementName="CollectionTree" />
                                            <Binding RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </Grid.Width>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE8B7;"
                                                   Margin="0,0,6,0"
                                                   Foreground="{StaticResource App.MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <Button Content="+"
                                                Style="{StaticResource TreeActionButton}"
                                                ToolTip="Add child"
                                                Click="TreeAddButton_OnClick" />
                                        <Button Content="-"
                                                Style="{StaticResource TreeActionButton}"
                                                Margin="4,0,0,0"
                                                ToolTip="Delete"
                                                Click="TreeDeleteButton_OnClick" />
                                        <Button Content="…"
                                                Style="{StaticResource TreeActionButton}"
                                                Margin="4,0,0,0"
                                                ToolTip="More actions"
                                                Click="TreeMoreButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type vm:RequestNodeViewModel}">
                                <Grid MinHeight="22" Margin="0,1">
                                    <Grid.Width>
                                        <MultiBinding Converter="{StaticResource TreeRowWidth}">
                                            <Binding Path="ActualWidth" ElementName="CollectionTree" />
                                            <Binding RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </Grid.Width>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Verb}"
                                                   Width="56"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Verb, Converter={StaticResource VerbBrush}}" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <FrameworkElement Width="22" Margin="0,0,4,0" />
                                        <Button Content="-"
                                                Style="{StaticResource TreeActionButton}"
                                                ToolTip="Delete"
                                                Click="TreeDeleteButton_OnClick" />
                                        <Button Content="…"
                                                Style="{StaticResource TreeActionButton}"
                                                Margin="4,0,0,0"
                                                ToolTip="More actions"
                                                Click="TreeMoreButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource App.BorderBrush}"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2" Background="{StaticResource App.PanelBrush}">
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNodeSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="Select an item"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.MutedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#FF9CA3AF"
                                   HorizontalAlignment="Center"
                                   Text="Choose a collection, folder, or request in the tree. Double-click to edit its name." />
                    </StackPanel>
                </Border>

                <Border Margin="12"
                        Visibility="{Binding IsCollectionSelected, Converter={StaticResource BoolToVis}}">
                    <views:CollectionEditorView x:Name="CollectionEditor"
                                                DataContext="{Binding SelectedCollection}" />
                </Border>

                <Border Margin="12"
                        Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVis}}">
                    <views:FolderEditorView x:Name="FolderEditor"
                                            DataContext="{Binding SelectedFolder}" />
                </Border>

                <Grid Visibility="{Binding IsRequestSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" MinHeight="220" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="2*" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <views:RequestEditorView x:Name="RequestEditor"
                                             Grid.Row="0"
                                             Margin="12,12,12,4"
                                             DataContext="{Binding SelectedRequest}" />

                    <GridSplitter Grid.Row="1"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{StaticResource App.BorderBrush}"
                                  ShowsPreview="True"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" />

                    <views:ResponsePanelView Grid.Row="2"
                                             Margin="12,4,12,12"
                                             DataContext="{Binding Response}" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
