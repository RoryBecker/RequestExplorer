<Window x:Class="RequestExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RequestExplorer"
        Height="720"
        Width="1200"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="160" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Left: collections / folders / requests (Phase 1) -->
        <Border Grid.Column="0"
                Background="#FFF5F5F5"
                BorderBrush="#FFD0D0D0"
                BorderThickness="0,0,0,0"
                Padding="12">
            <TextBlock Text="Collections"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FF666666"
                       VerticalAlignment="Top" />
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#FFE0E0E0"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Right: request editor + response (Phases 2–5) -->
        <Border Grid.Column="2"
                Background="#FFFFFFFF"
                Padding="12">
            <TextBlock Text="Select a request"
                       FontSize="14"
                       Foreground="#FF999999"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
