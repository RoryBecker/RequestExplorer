<Window x:Class="RequestExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RequestExplorer.ViewModels"
        xmlns:views="clr-namespace:RequestExplorer.Views"
        mc:Ignorable="d"
        Title="RequestExplorer"
        Height="720"
        Width="1200"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding AddCollectionCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameNodeCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteNodeCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionSummary}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="#FFF5F5F5">
                <ToolBarTray DockPanel.Dock="Top" Background="#FFF5F5F5">
                    <ToolBar Band="0" BandIndex="0" ToolBarTray.IsLocked="True">
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                ToolTip="Save collection (Ctrl+S)" />
                        <Separator />
                        <Button Content="Collection" Command="{Binding AddCollectionCommand}"
                                ToolTip="New collection (Ctrl+Shift+N)" />
                        <Button Content="Folder" Command="{Binding AddFolderCommand}"
                                ToolTip="New folder under selection" />
                        <Button Content="Request" Command="{Binding AddRequestCommand}"
                                ToolTip="New request under selection" />
                        <Separator />
                        <Button Content="Rename" Command="{Binding RenameNodeCommand}"
                                ToolTip="Rename (F2)" />
                        <Button Content="Delete" Command="{Binding DeleteNodeCommand}"
                                ToolTip="Delete (Del)" />
                    </ToolBar>
                </ToolBarTray>

                <TextBlock DockPanel.Dock="Top"
                           Margin="12,8,12,4"
                           Text="Collections"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FF666666" />

                <TreeView x:Name="CollectionTree"
                          Margin="4,0,4,8"
                          ItemsSource="{Binding Collections}"
                          SelectedItemChanged="CollectionTree_OnSelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2" />
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                            <MenuItem Header="Save All" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                            <Separator />
                            <MenuItem Header="New Collection" Command="{Binding AddCollectionCommand}" />
                            <MenuItem Header="New Folder" Command="{Binding AddFolderCommand}" />
                            <MenuItem Header="New Request" Command="{Binding AddRequestCommand}" />
                            <Separator />
                            <MenuItem Header="Rename" Command="{Binding RenameNodeCommand}" InputGestureText="F2" />
                            <MenuItem Header="Delete" Command="{Binding DeleteNodeCommand}" InputGestureText="Del" />
                        </ContextMenu>
                    </TreeView.ContextMenu>

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:CollectionNodeViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        </HierarchicalDataTemplate>

                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" />
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type vm:RequestNodeViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Verb}"
                                           Width="56"
                                           FontWeight="SemiBold"
                                           Foreground="#FF2B6CB0" />
                                <TextBlock Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FFE0E0E0"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Right: request editor + response (Phase 2) -->
            <Grid Grid.Column="2" Background="#FFFFFFFF">
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRequestSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Select a request"
                                   FontSize="14"
                                   Foreground="#FF999999"
                                   HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SelectionSummary}"
                                   FontSize="12"
                                   Foreground="#FFBBBBBB"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Visibility="{Binding IsRequestSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="160" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <views:RequestEditorView Grid.Row="0"
                                             Margin="12,12,12,4"
                                             DataContext="{Binding SelectedRequest}" />

                    <GridSplitter Grid.Row="1"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#FFE0E0E0"
                                  ShowsPreview="True"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" />

                    <views:ResponsePanelView Grid.Row="2"
                                             Margin="12,4,12,12" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
