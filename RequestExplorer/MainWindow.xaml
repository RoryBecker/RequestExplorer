<Window x:Class="RequestExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RequestExplorer.ViewModels"
        xmlns:views="clr-namespace:RequestExplorer.Views"
        xmlns:conv="clr-namespace:RequestExplorer.Converters"
        mc:Ignorable="d"
        Title="RequestExplorer"
        Height="720"
        Width="1200"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:VerbToBrushConverter x:Key="VerbBrush" />

        <!-- ~50% lighter than accent blue for selection -->
        <SolidColorBrush x:Key="Tree.SelectionBrush" Color="#802563EB" />
        <SolidColorBrush x:Key="Tree.InactiveSelectionBrush" Color="#402563EB" />
        <SolidColorBrush x:Key="Tree.DropIntoBrush" Color="#332563EB" />

        <Style x:Key="TreeDropBeforeLine" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Background" Value="{StaticResource App.AccentBrush}" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DropIndicator}" Value="{x:Static vm:TreeDropIndicator.Before}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeDropAfterLine" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="Background" Value="{StaticResource App.AccentBrush}" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DropIndicator}" Value="{x:Static vm:TreeDropIndicator.After}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeDropIntoHighlight" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DropIndicator}" Value="{x:Static vm:TreeDropIndicator.Into}">
                    <Setter Property="Background" Value="{StaticResource Tree.DropIntoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stretch header content so row grids can right-align action buttons. -->
        <Style x:Key="TreeExpandToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <!-- Hit target larger than the glyph; Path geometry unchanged. -->
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"
                                Width="22"
                                Height="22">
                            <Path x:Name="ExpandPath"
                                  Data="M 1,0 L 5.5,3.5 L 1,7 Z"
                                  Fill="#FF6B7280"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Fill" Value="#FF2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding AddCollectionCommand}" />
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding SendRequestCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateNodeCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyNodeCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding SmartPasteCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameNodeCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteNodeCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveNodeUpCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveNodeDownCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _All" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="_Reload from Disk" Command="{Binding ReloadFromDiskCommand}" />
                <Separator />
                <MenuItem Header="_Backup now" Command="{Binding BackupNowCommand}" />
                <MenuItem Header="R_estore…" Command="{Binding RestoreBackupCommand}" />
                <MenuItem Header="Open _backups folder" Command="{Binding OpenBackupsFolderCommand}" />
                <Separator />
                <MenuItem Header="Open collections _folder" Command="{Binding OpenStorageFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoMenuHeader}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{Binding RedoMenuHeader}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="New _Collection" Command="{Binding AddCollectionCommand}" InputGestureText="Ctrl+Shift+N" />
                <MenuItem Header="New _Folder" Command="{Binding AddFolderCommand}" />
                <MenuItem Header="New _Request" Command="{Binding AddRequestCommand}" />
                <MenuItem Header="_Duplicate" Command="{Binding DuplicateNodeCommand}" InputGestureText="Ctrl+D" />
                <Separator />
                <MenuItem Header="_Copy" Command="{Binding CopyNodeCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="_Paste" Command="{Binding SmartPasteCommand}" InputGestureText="Ctrl+V" />
                <MenuItem Header="Paste at _Top Level" Command="{Binding PasteAtRootCommand}" />
                <Separator />
                <MenuItem Header="_Rename" Command="{Binding RenameNodeCommand}" InputGestureText="F2" />
                <MenuItem Header="Move _Up" Command="{Binding MoveNodeUpCommand}" InputGestureText="Alt+Up" />
                <MenuItem Header="Move _Down" Command="{Binding MoveNodeDownCommand}" InputGestureText="Alt+Down" />
                <MenuItem Header="Move to New _Sub-folder…" Command="{Binding MoveToNewSubFolderCommand}" />
                <MenuItem Header="_Delete" Command="{Binding DeleteNodeCommand}" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="Edit as _JSON…" Command="{Binding EditAsJsonCommand}" />
            </MenuItem>
            <MenuItem Header="_Request">
                <MenuItem Header="_Send" Command="{Binding SendRequestCommand}" InputGestureText="Ctrl+Enter" />
                <MenuItem Header="{Binding RunAllRequestsMenuHeader}" Command="{Binding RunAllRequestsCommand}" />
                <MenuItem Header="_Cancel" Command="{Binding CancelSendCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About RequestExplorer" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource App.SurfaceBrush}"
                BorderBrush="{StaticResource App.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <ToolBarTray Background="Transparent">
                <ToolBar Band="0"
                         BandIndex="0"
                         ToolBarTray.IsLocked="True"
                         Background="Transparent"
                         DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

                    <!-- Undo split -->
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding UndoCommand}"
                            ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE7A7;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSplitChevron}"
                            IsEnabled="{Binding HasUndoHistory}"
                            ToolTip="Undo multiple"
                            Click="UndoHistoryDrop_OnClick">
                        <TextBlock Style="{StaticResource ToolbarIconText}" FontSize="10" Text="&#xE70D;" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="UndoHistoryMenu"
                                         MinWidth="220"
                                         ItemsSource="{Binding UndoMenuItems}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Description}" />
                                        <Setter Property="Command"
                                                Value="{Binding DataContext.UndoToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding Depth}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Redo split -->
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding RedoCommand}"
                            ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE7A6;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSplitChevron}"
                            IsEnabled="{Binding HasRedoHistory}"
                            ToolTip="Redo multiple"
                            Click="RedoHistoryDrop_OnClick">
                        <TextBlock Style="{StaticResource ToolbarIconText}" FontSize="10" Text="&#xE70D;" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="RedoHistoryMenu"
                                         MinWidth="220"
                                         ItemsSource="{Binding RedoMenuItems}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Description}" />
                                        <Setter Property="Command"
                                                Value="{Binding DataContext.RedoToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding Depth}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Separator />

                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding SaveCommand}"
                            ToolTip="Save (Ctrl+S)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE74E;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding SaveAllCommand}"
                            ToolTip="Save all (Ctrl+Shift+S)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE792;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding ReloadFromDiskCommand}"
                            ToolTip="Reload collections from disk">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE72C;" />
                    </Button>

                    <Separator />

                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding AddCollectionCommand}"
                            ToolTip="New collection (Ctrl+Shift+N)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE8B7;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding AddFolderCommand}"
                            ToolTip="New folder under selection">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE8F4;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding AddRequestCommand}"
                            ToolTip="New request under selection">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE8A5;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding DuplicateNodeCommand}"
                            ToolTip="Duplicate (Ctrl+D)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE8C8;" />
                    </Button>

                    <Separator />

                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding CopyNodeCommand}"
                            ToolTip="Copy tree item (Ctrl+C)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE8DE;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding SmartPasteCommand}"
                            ToolTip="Paste into collection or folder (Ctrl+V)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE77D;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding PasteAtRootCommand}"
                            ToolTip="Paste as new top-level collection">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE8A9;" />
                    </Button>

                    <Separator />

                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding RenameNodeCommand}"
                            ToolTip="Rename (F2)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE70F;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding DeleteNodeCommand}"
                            ToolTip="Delete (Del)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE74D;" />
                    </Button>

                    <Separator />

                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding SendRequestCommand}"
                            ToolTip="Send request (Ctrl+Enter)">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE724;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding CancelSendCommand}"
                            ToolTip="Cancel in-flight request">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE711;" />
                    </Button>

                    <Separator />

                    <ToggleButton Style="{StaticResource ToolbarIconToggleButton}"
                                  IsChecked="{Binding IsQuickExportVisible, Mode=TwoWay}"
                                  ToolTip="Show/Hide Quick Export">
                        <TextBlock Style="{StaticResource ToolbarIconText}" Text="&#xE8F2;" />
                    </ToggleButton>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectionSummary}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StorageDirectory}"
                           ToolTip="Collections storage path"
                           Opacity="0.75"
                           FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CollectionsColumn" Width="360" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{StaticResource App.SurfaceBrush}">
                <TextBlock DockPanel.Dock="Top"
                           Margin="12,8,12,4"
                           Text="Collections"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.MutedBrush}" />

                <Grid DockPanel.Dock="Top" Margin="8,0,8,6" MinHeight="28">
                    <TextBox x:Name="TreeFilterBox"
                             Text="{Binding TreeFilterText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,4,52,4"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource App.BorderBrush}"
                             ToolTip="{Binding TreeFilterPlaceholder}"
                             PreviewKeyDown="TreeFilterBox_OnPreviewKeyDown" />
                    <TextBlock Text="{Binding TreeFilterPlaceholder}"
                               Margin="10,0,52,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource App.MutedBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTreeFilter}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,2,0">
                        <Button Content="✕"
                                Width="22"
                                Height="22"
                                Style="{StaticResource TreeActionButton}"
                                ToolTip="Clear filter"
                                Command="{Binding ClearTreeFilterCommand}"
                                Visibility="{Binding HasTreeFilter, Converter={StaticResource BoolToVis}}" />
                        <Button x:Name="TreeFilterOptionsButton"
                                Content="…"
                                Width="22"
                                Height="22"
                                Style="{StaticResource TreeActionButton}"
                                ToolTip="Choose filter fields"
                                Click="TreeFilterOptionsButton_OnClick">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Ancestor path"
                                              IsCheckable="True"
                                              StaysOpenOnClick="True"
                                              IsChecked="{Binding TreeFilterIncludeAncestors, Mode=TwoWay}" />
                                    <MenuItem Header="Name"
                                              IsCheckable="True"
                                              StaysOpenOnClick="True"
                                              IsChecked="{Binding TreeFilterIncludeName, Mode=TwoWay}" />
                                    <MenuItem Header="URL"
                                              IsCheckable="True"
                                              StaysOpenOnClick="True"
                                              IsChecked="{Binding TreeFilterIncludeUrl, Mode=TwoWay}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="CollectionsDropHost">
                    <Border Margin="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCollections}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <TextBlock Text="No collections yet"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource App.MutedBrush}" />
                            <TextBlock Margin="0,8,0,12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource App.MutedBrush}"
                                       Text="Create a collection, or drop Postman .json files here to import." />
                            <Button Content="New Collection"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddCollectionCommand}" />
                        </StackPanel>
                    </Border>

                    <DockPanel Visibility="{Binding HasCollections, Converter={StaticResource BoolToVis}}">
                        <Border DockPanel.Dock="Top"
                                Height="3"
                                Margin="8,4,8,0"
                                Background="{StaticResource App.AccentBrush}"
                                CornerRadius="1"
                                Visibility="{Binding IsRootDropIndicatorVisible, Converter={StaticResource BoolToVis}}" />

                        <TreeView x:Name="CollectionTree"
                              Margin="4,0,4,8"
                              BorderThickness="0"
                              Background="Transparent"
                              AllowDrop="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsSource="{Binding Collections}"
                              SelectedItemChanged="CollectionTree_OnSelectedItemChanged"
                              PreviewMouseLeftButtonDown="CollectionTree_OnPreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="CollectionTree_OnPreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="CollectionTree_OnPreviewMouseRightButtonDown"
                              PreviewKeyDown="CollectionTree_OnPreviewKeyDown"
                              ContextMenuOpening="CollectionTree_OnContextMenuOpening">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Visibility" Value="{Binding IsVisibleInFilter, Converter={StaticResource BoolToVis}}" />
                                <Setter Property="Padding" Value="2,1,2,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="AllowDrop" Value="True" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <EventSetter Event="PreviewMouseDoubleClick" Handler="TreeViewItem_OnPreviewMouseDoubleClick" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <ToggleButton x:Name="Expander"
                                                              Style="{StaticResource TreeExpandToggle}"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                              ClickMode="Press"
                                                              Margin="0,0,1,0" />

                                                <Border x:Name="Bd"
                                                        Grid.Column="1"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>

                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Margin="8,0,0,0" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsInSelection}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tree.SelectionBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tree.SelectionBrush}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True" />
                                                        <Condition Property="IsSelectionActive" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tree.InactiveSelectionBrush}" />
                                                </MultiTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Diagnose Variables" Command="{Binding DiagnoseVariablesCommand}" />
                                <MenuItem Header="{Binding RunAllRequestsMenuHeader}" Command="{Binding RunAllRequestsCommand}" />
                                <Separator />
                                <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                                <MenuItem Header="Save All" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                                <Separator />
                                <MenuItem Header="New Collection" Command="{Binding AddCollectionCommand}" />
                                <MenuItem Header="New Folder" Command="{Binding AddFolderCommand}" />
                                <MenuItem Header="New Request" Command="{Binding AddRequestCommand}" />
                                <MenuItem Header="Duplicate" Command="{Binding DuplicateNodeCommand}" InputGestureText="Ctrl+D" />
                                <Separator />
                                <MenuItem Header="Expand All Children" Command="{Binding ExpandChildrenCommand}" />
                                <MenuItem Header="Collapse All Children" Command="{Binding CollapseChildrenCommand}" />
                                <Separator />
                                <MenuItem Header="Copy" Command="{Binding CopyNodeCommand}" InputGestureText="Ctrl+C" />
                                <MenuItem x:Name="CopyToCollectionMenuItem" Header="Copy to Collection" />
                                <MenuItem Header="Paste" Command="{Binding SmartPasteCommand}" InputGestureText="Ctrl+V" />
                                <MenuItem Header="Paste at Top Level" Command="{Binding PasteAtRootCommand}" />
                                <Separator />
                                <MenuItem Header="Move Up" Command="{Binding MoveNodeUpCommand}" InputGestureText="Alt+Up" />
                                <MenuItem Header="Move Down" Command="{Binding MoveNodeDownCommand}" InputGestureText="Alt+Down" />
                                <MenuItem Header="Move to New Sub-folder…" Command="{Binding MoveToNewSubFolderCommand}" />
                                <Separator />
                                <MenuItem Header="Rename" Command="{Binding RenameNodeCommand}" InputGestureText="F2" />
                                <MenuItem Header="Delete" Command="{Binding DeleteNodeCommand}" InputGestureText="Del" />
                                <Separator />
                                <MenuItem Header="Edit as JSON…" Command="{Binding EditAsJsonCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:CollectionNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Border Style="{StaticResource TreeDropBeforeLine}" />
                                    <Border Style="{StaticResource TreeDropIntoHighlight}">
                                        <Grid MinHeight="22" Margin="0,1" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE8F1;"
                                                           Margin="0,0,6,0"
                                                           Foreground="{StaticResource App.AccentBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE81E;"
                                                           Margin="0,0,4,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource App.MutedBrush}"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding VariablesTooltip}"
                                                           Visibility="{Binding HasDefinedVariables, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                <Button Content="+"
                                                        Style="{StaticResource TreeActionButton}"
                                                        ToolTip="Add child"
                                                        Click="TreeAddButton_OnClick" />
                                                <Button Content="…"
                                                        Style="{StaticResource TreeActionButton}"
                                                        Margin="4,0,0,0"
                                                        ToolTip="More actions"
                                                        Click="TreeMoreButton_OnClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TreeDropAfterLine}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Border Style="{StaticResource TreeDropBeforeLine}" />
                                    <Border Style="{StaticResource TreeDropIntoHighlight}">
                                        <Grid MinHeight="22" Margin="0,1" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE8B7;"
                                                           Margin="0,0,6,0"
                                                           Foreground="{StaticResource App.MutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE81E;"
                                                           Margin="0,0,4,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource App.MutedBrush}"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding VariablesTooltip}"
                                                           Visibility="{Binding HasDefinedVariables, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                <Button Content="+"
                                                        Style="{StaticResource TreeActionButton}"
                                                        ToolTip="Add child"
                                                        Click="TreeAddButton_OnClick" />
                                                <Button Content="…"
                                                        Style="{StaticResource TreeActionButton}"
                                                        Margin="4,0,0,0"
                                                        ToolTip="More actions"
                                                        Click="TreeMoreButton_OnClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TreeDropAfterLine}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type vm:RequestNodeViewModel}">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Border Style="{StaticResource TreeDropBeforeLine}" />
                                    <Border Style="{StaticResource TreeDropIntoHighlight}">
                                        <Grid MinHeight="22" Margin="0,1" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Verb}"
                                                           Margin="0,0,6,0"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Verb, Converter={StaticResource VerbBrush}}" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                <Button Content="…"
                                                        Style="{StaticResource TreeActionButton}"
                                                        ToolTip="More actions"
                                                        Click="TreeMoreButton_OnClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TreeDropAfterLine}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource App.BorderBrush}"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="PanelSplitter_OnDragCompleted" />

            <Grid Grid.Column="2" Background="{StaticResource App.PanelBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition x:Name="QuickExportSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="QuickExportColumn" Width="0" MinWidth="0" MaxWidth="720" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNodeSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="Select an item"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource App.MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,8,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#FF9CA3AF"
                                       HorizontalAlignment="Center"
                                       Text="Choose a collection, folder, or request in the tree. Double-click to edit its name." />
                        </StackPanel>
                    </Border>

                    <Border Margin="12"
                            Visibility="{Binding IsCollectionSelected, Converter={StaticResource BoolToVis}}">
                        <views:CollectionEditorView x:Name="CollectionEditor"
                                                    DataContext="{Binding SelectedCollection}" />
                    </Border>

                    <Border Margin="12"
                            Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVis}}">
                        <views:FolderEditorView x:Name="FolderEditor"
                                                DataContext="{Binding SelectedFolder}" />
                    </Border>

                    <Grid x:Name="RequestResponseGrid"
                          Visibility="{Binding IsRequestSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RequestRow" Height="3*" MinHeight="220" />
                            <RowDefinition Height="6" />
                            <RowDefinition x:Name="ResponseRow" Height="2*" MinHeight="160" />
                        </Grid.RowDefinitions>

                        <views:RequestEditorView x:Name="RequestEditor"
                                                 Grid.Row="0"
                                                 Margin="12,12,12,4"
                                                 DataContext="{Binding SelectedRequest}" />

                        <GridSplitter Grid.Row="1"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{StaticResource App.BorderBrush}"
                                      ShowsPreview="True"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      DragCompleted="PanelSplitter_OnDragCompleted" />

                        <views:ResponsePanelView Grid.Row="2"
                                                 Margin="4,0,4,4"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 DataContext="{Binding SelectedRequest.LastResponse}" />
                    </Grid>
                </Grid>

                <GridSplitter x:Name="QuickExportSplitter"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{StaticResource App.BorderBrush}"
                              ShowsPreview="True"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Visibility="{Binding IsQuickExportVisible, Converter={StaticResource BoolToVis}}"
                              DragCompleted="PanelSplitter_OnDragCompleted" />

                <Border x:Name="QuickExportHost"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource App.SurfaceBrush}"
                        BorderBrush="{StaticResource App.BorderBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding IsQuickExportVisible, Converter={StaticResource BoolToVis}}">
                    <views:QuickExportView />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
