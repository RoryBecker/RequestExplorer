<Window x:Class="RequestExplorer.Views.ApplyVariableToUrlsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:otherHelpers="clr-namespace:RequestExplorer.Views.OtherHelpers"
        Title="Apply Variable to URLs"
        Width="720"
        Height="540"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.PanelBrush}">
    <Window.Resources>
        <Style x:Key="KeyValueGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.SelectionTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyValueCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource App.MutedBrush}"
                   Text="{Binding IntroText}" />

        <DataGrid Grid.Row="1"
                  Style="{StaticResource KeyValueGrid}"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="On"
                                        Width="44"
                                        SortMemberPath="IsChecked"
                                        CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Request"
                                    Binding="{Binding Path}"
                                    Width="*"
                                    MinWidth="120"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource KeyValueCellText}" />
                <DataGridTextColumn Header="URL"
                                    Binding="{Binding Address}"
                                    Width="2*"
                                    MinWidth="160"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource KeyValueCellText}" />
                <DataGridTextColumn Header="Matches"
                                    Binding="{Binding MatchSummary}"
                                    Width="140"
                                    MinWidth="90"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource KeyValueCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,4"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.MutedBrush}"
                       Text="PREVIEW" />
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MinHeight="56"
                          MaxHeight="96"
                          Padding="8,6"
                          BorderBrush="{DynamicResource App.BorderBrush}"
                          BorderThickness="1"
                          Background="{DynamicResource App.SubtlePanelBrush}">
                <TextBlock FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource App.MutedBrush}"
                           otherHelpers:ResolvedTextHighlight.Spans="{Binding PreviewSpans, Mode=OneWay}" />
            </ScrollViewer>
        </DockPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="OK"
                    Width="88"
                    Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    IsEnabled="{Binding CanConfirm}"
                    Click="Ok_Click" />
            <Button Content="Cancel"
                    Width="88"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
