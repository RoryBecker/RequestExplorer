<Window x:Class="RequestExplorer.Views.DiagnosisReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Variable Diagnosis"
        Height="420"
        Width="620"
        MinHeight="280"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.PanelBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <RichTextBox x:Name="ReportBox"
                     Grid.Row="0"
                     IsReadOnly="True"
                     IsDocumentEnabled="True"
                     IsUndoEnabled="False"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8"
                     BorderBrush="{DynamicResource App.BorderBrush}"
                     BorderThickness="1"
                     Background="{DynamicResource App.SubtlePanelBrush}"
                     Cursor="Arrow" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource App.MutedBrush}"
                   Text="Click a node name to select it. Right-click {{variable}} to define it or go to its definition." />

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="FlattenExportButton"
                    DockPanel.Dock="Left"
                    Content="Export Flattened…"
                    MinWidth="140"
                    Padding="12,1"
                    Visibility="Collapsed"
                    Click="FlattenExport_Click" />
            <Button DockPanel.Dock="Right"
                    Content="Close"
                    Width="88"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
