<UserControl x:Class="RequestExplorer.Views.FolderEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RequestExplorer.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="KeyValueGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="views:KeyValueGridSorting.SpareAwareSort" Value="True" />
            <Setter Property="views:KeyValueGridClipboard.EnableRowClipboard" Value="True" />
            <Setter Property="views:KeyValueGridVariableMenus.EnableMoveMenus" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.SelectionTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyValueCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="views:VariableTokenToolTips.IsEnabled" Value="True" />
        </Style>

        <Style x:Key="KeyValueCellTextPlain" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="KeyValueCellEdit" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="views:VariableTokenToolTips.IsEnabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBox x:Name="TitleBox"
                     DockPanel.Dock="Left"
                     MinWidth="200"
                     MaxWidth="480"
                     FontSize="16"
                     FontWeight="SemiBold"
                     BorderThickness="0,0,0,1"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=Explicit}" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.WarnBrush}"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                       Text="Unsaved changes *  (Ctrl+S to save)" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,8"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource App.MutedBrush}"
                   Text="FOLDER" />

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock FontSize="13" Foreground="{DynamicResource App.TextBrush}">
                <Run Text="{Binding ChildFolderCount, Mode=OneWay}" />
                <Run Text=" folder(s)," />
                <Run Text="{Binding ChildRequestCount, Mode=OneWay}" />
                <Run Text=" request(s)" />
            </TextBlock>
            <TextBlock Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource App.MutedBrush}"
                       Text="{}Variables defined here override matching names from parent folders or the collection when resolving {{name}}." />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,6"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.MutedBrush}"
                       Text="VARIABLES" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="140" MinHeight="56" MaxHeight="480" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           views:CollapsibleGridRow.CollapseWhenHidden="True"
                           Visibility="{Binding HasInheritedVariables, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.MutedBrush}"
                               Text="INHERITED" />
                    <DataGrid ItemsSource="{Binding InheritedVariables}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource App.GridLineBrush}"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource App.BorderBrush}"
                              RowHeight="28"
                              ColumnHeaderHeight="26"
                              MinHeight="40"
                              VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource App.SubtlePanelBrush}"
                              Foreground="{DynamicResource App.MutedBrush}"
                              views:KeyValueGridClipboard.EnableRowClipboard="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key"
                                                Binding="{Binding Key}"
                                                Width="*"
                                                MinWidth="60"
                                                ElementStyle="{StaticResource KeyValueCellText}" />
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding VariableValue}"
                                                Width="2*"
                                                MinWidth="80"
                                                ElementStyle="{StaticResource KeyValueCellTextPlain}" />
                            <DataGridTextColumn Header=""
                                                Binding="{Binding StatusDisplay}"
                                                Width="90"
                                                MinWidth="48"
                                                ElementStyle="{StaticResource KeyValueCellTextPlain}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShadowed}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>

                <GridSplitter Grid.Row="1"
                              Height="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Cursor="SizeNS"
                              Background="{DynamicResource App.GridLineBrush}"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              ShowsPreview="False"
                              ToolTip="Drag to resize Inherited / Local"
                              Panel.ZIndex="1"
                              views:CollapsibleGridRow.CollapseWhenHidden="True"
                              Visibility="{Binding HasInheritedVariables, Converter={StaticResource BoolToVis}}" />

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,4,0,4"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.MutedBrush}"
                               Text="LOCAL" />
                    <DataGrid Style="{StaticResource KeyValueGrid}"
                              ItemsSource="{Binding Variables}"
                              SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                              views:KeyValueGridSelectionSync.BringSelectedIntoView="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On"
                                                    Width="44"
                                                    SortMemberPath="IsEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding HasKey}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Key"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"
                                                ElementStyle="{StaticResource KeyValueCellText}"
                                                EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*"
                                                ElementStyle="{StaticResource KeyValueCellText}"
                                                EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                            <DataGridTemplateColumn Header=""
                                                    Width="36"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="-"
                                                Style="{StaticResource TreeActionButton}"
                                                ToolTip="Remove row"
                                                Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.RemoveVariableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="New Folder"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding DataContext.AddFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="New Request"
                    Command="{Binding DataContext.AddRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
    </Grid>
</UserControl>
