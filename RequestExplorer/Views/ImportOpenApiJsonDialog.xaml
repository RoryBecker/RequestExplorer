<Window x:Class="RequestExplorer.Views.ImportOpenApiJsonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from OpenAPI JSON"
        Height="640"
        Width="820"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.PanelBrush}"
        Foreground="{DynamicResource App.TextBrush}"
        Closing="Window_OnClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SubtitleText"
                   Grid.Row="0"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource App.MutedBrush}"
                   TextWrapping="Wrap"
                   Text="Paste an OpenAPI 3.x or Swagger 2.0 JSON document." />

        <TextBox x:Name="EditorBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Padding="8"
                 BorderBrush="{DynamicResource App.BorderBrush}"
                 BorderThickness="1"
                 Background="{DynamicResource App.SubtlePanelBrush}"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch" />

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource App.DangerBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Format"
                        Width="88"
                        Click="Format_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply"
                        Width="88"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="Apply_Click" />
                <Button Content="Cancel"
                        Width="88"
                        IsCancel="True"
                        Click="Cancel_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
