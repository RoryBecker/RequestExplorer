<Window x:Class="RequestExplorer.Views.NewItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New"
        SizeToContent="WidthAndHeight"
        MinWidth="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   FontSize="13"
                   Text="Create:" />

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <RadioButton x:Name="CollectionRadio"
                         Content="_Collection"
                         GroupName="NewItemKind"
                         Margin="0,0,0,8"
                         Checked="Radio_OnChecked" />
            <RadioButton x:Name="FolderRadio"
                         Content="_Folder"
                         GroupName="NewItemKind"
                         Margin="0,0,0,8"
                         Checked="Radio_OnChecked" />
            <RadioButton x:Name="RequestRadio"
                         Content="_Request"
                         GroupName="NewItemKind"
                         Checked="Radio_OnChecked" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="88"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Ok_Click" />
            <Button Content="Cancel"
                    Width="88"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
