<UserControl x:Class="RequestExplorer.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RequestExplorer.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="KeyValueGrid" TargetType="DataGrid">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#802563EB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF1F2937" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#402563EB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF1F2937" />
            </Style.Resources>
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEEEEEE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FFE5E7EB" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#802563EB" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF1F2937" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#402563EB" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF1F2937" />
                        </Style.Resources>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#802563EB" />
                                <Setter Property="Foreground" Value="#FF1F2937" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyValueCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="KeyValueCellEdit" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBox x:Name="TitleBox"
                     DockPanel.Dock="Left"
                     MinWidth="200"
                     MaxWidth="480"
                     FontSize="16"
                     FontWeight="SemiBold"
                     BorderThickness="0,0,0,1"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=Explicit}" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FFB45309"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                       Text="Unsaved changes *  (Ctrl+S to save)" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Margin="0,0,8,0"
                      Height="32"
                      ItemsSource="{x:Static vm:RequestNodeViewModel.VerbOptions}"
                      SelectedItem="{Binding Verb, Mode=TwoWay}" />

            <TextBox Grid.Column="1"
                     Height="32"
                     VerticalContentAlignment="Center"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Send"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="Send request (Ctrl+Enter)"
                    Command="{Binding DataContext.SendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Grid.Column="3"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Cancel"
                    ToolTip="Cancel in-flight request"
                    Command="{Binding DataContext.CancelSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>

        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding DataContext.SelectedRequestTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
            <TabItem Header="Params">
                <DataGrid Style="{StaticResource KeyValueGrid}"
                          Margin="8"
                          ItemsSource="{Binding Params}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Key"
                                            Binding="{Binding Key, UpdateSourceTrigger=LostFocus}"
                                            Width="*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                            Width="2*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-"
                                            Style="{StaticResource TreeActionButton}"
                                            ToolTip="Remove row"
                                            Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveParamCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Body">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="Content-Type" />
                        <TextBox Width="220"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding BodyContentType, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <TextBox AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Text="{Binding BodyContent, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Headers">
                <DataGrid Style="{StaticResource KeyValueGrid}"
                          Margin="8"
                          ItemsSource="{Binding Headers}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Key"
                                            Binding="{Binding Key, UpdateSourceTrigger=LostFocus}"
                                            Width="*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                            Width="2*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-"
                                            Style="{StaticResource TreeActionButton}"
                                            ToolTip="Remove row"
                                            Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Auth">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Type" />
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Static vm:RequestNodeViewModel.AuthTypeOptions}"
                                  SelectedItem="{Binding AuthType, Mode=TwoWay}" />

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthBearer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Bearer token" />
                            <TextBox Text="{Binding BearerToken, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthBasic, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Username" />
                            <TextBox Margin="0,0,0,8"
                                     Text="{Binding BasicUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Password" />
                            <TextBox Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthApiKey, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key name" />
                            <TextBox Margin="0,0,0,8"
                                     Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key value" />
                            <TextBox Margin="0,0,0,8"
                                     Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Add to" />
                            <ComboBox Width="160"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{x:Static vm:RequestNodeViewModel.ApiKeyLocationOptions}"
                                      SelectedItem="{Binding ApiKeyLocation, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   Foreground="#FF888888"
                                   Visibility="{Binding IsAuthNone, Converter={StaticResource BoolToVis}}"
                                   Text="No authentication will be applied when sending." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
