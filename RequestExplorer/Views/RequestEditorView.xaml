<UserControl x:Class="RequestExplorer.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RequestExplorer.ViewModels.Nodes"
             xmlns:views="clr-namespace:RequestExplorer.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="KeyValueGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="views:KeyValueGridSorting.SpareAwareSort" Value="True" />
            <Setter Property="views:KeyValueGridClipboard.EnableRowClipboard" Value="True" />
            <Setter Property="views:KeyValueGridVariableMenus.EnableMoveMenus" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.SelectionTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyValueCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="views:VariableTokenToolTips.IsEnabled" Value="True" />
        </Style>

        <Style x:Key="KeyValueCellEdit" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="views:VariableTokenToolTips.IsEnabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBox x:Name="TitleBox"
                     DockPanel.Dock="Left"
                     MinWidth="200"
                     MaxWidth="480"
                     FontSize="16"
                     FontWeight="SemiBold"
                     BorderThickness="0,0,0,1"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=Explicit}" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.WarnBrush}"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                       Text="Unsaved changes *  (Ctrl+S to save)" />
            <CheckBox DockPanel.Dock="Right"
                      Margin="12,0,12,0"
                      VerticalAlignment="Center"
                      Content="Opt out of auto run"
                      ToolTip="Skip this request when using Run All Requests. Diagnose Variables still includes it."
                      IsChecked="{Binding OptOutOfAutoRun}" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Margin="0,0,8,0"
                      Height="32"
                      FontSize="13"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Left"
                      Padding="8,4,24,4"
                      ItemsSource="{x:Static vm:RequestNodeViewModel.VerbOptions}"
                      SelectedItem="{Binding Verb, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Padding="2,0"
                                   Foreground="{DynamicResource App.TextBrush}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <TextBox Grid.Column="1"
                     Height="32"
                     VerticalContentAlignment="Center"
                     views:VariableTokenToolTips.IsEnabled="True"
                     views:UrlExtractAsVariableMenu.IsEnabled="True"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Send"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="Send request (Alt+X)"
                    Command="{Binding DataContext.SendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Grid.Column="3"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Cancel"
                    ToolTip="Cancel in-flight request"
                    Command="{Binding DataContext.CancelSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Grid.ColumnSpan="3"
                     Margin="0,4,0,0"
                     MinHeight="22"
                     Padding="6,2"
                     FontSize="11"
                     IsReadOnly="True"
                     IsTabStop="False"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource App.MutedBrush}"
                     VerticalContentAlignment="Center"
                     TextWrapping="Wrap"
                     ToolTip="URL with {{variables}} resolved from parent collection/folder scope"
                     Text="{Binding ResolvedAddress, Mode=OneWay}" />
        </Grid>

        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding DataContext.SelectedRequestTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
            <TabItem Header="Body">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="Content-Type" />
                        <TextBox Width="220"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 views:VariableTokenToolTips.IsEnabled="True"
                                 Text="{Binding BodyContentType, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBox AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             views:VariableTokenToolTips.IsEnabled="True"
                             views:JsonPathMenu.IsEnabled="True"
                             Text="{Binding BodyContent, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Params">
                <DataGrid Style="{StaticResource KeyValueGrid}"
                          Margin="8"
                          ItemsSource="{Binding Params}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On"
                                                Width="44"
                                                SortMemberPath="IsEnabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding HasKey}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Key"
                                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            Width="2*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTemplateColumn Header=""
                                                Width="36"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-"
                                            Style="{StaticResource TreeActionButton}"
                                            ToolTip="Remove row"
                                            Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveParamCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Headers">
                <DataGrid Style="{StaticResource KeyValueGrid}"
                          Margin="8"
                          ItemsSource="{Binding Headers}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On"
                                                Width="44"
                                                SortMemberPath="IsEnabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding HasKey}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Key"
                                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            Width="2*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTemplateColumn Header=""
                                                Width="36"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-"
                                            Style="{StaticResource TreeActionButton}"
                                            ToolTip="Remove row"
                                            Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Auth">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Type" />
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Static vm:RequestNodeViewModel.AuthTypeOptions}"
                                  SelectedItem="{Binding AuthType, Mode=TwoWay}" />

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthBearer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Bearer token" />
                            <TextBox x:Name="BearerTokenBox"
                                     views:VariableTokenToolTips.IsEnabled="True"
                                     Text="{Binding BearerToken, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthBasic, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Username" />
                            <TextBox Margin="0,0,0,8"
                                     views:VariableTokenToolTips.IsEnabled="True"
                                     Text="{Binding BasicUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Password" />
                            <TextBox views:VariableTokenToolTips.IsEnabled="True"
                                     Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthApiKey, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key name" />
                            <TextBox Margin="0,0,0,8"
                                     views:VariableTokenToolTips.IsEnabled="True"
                                     Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key value" />
                            <TextBox Margin="0,0,0,8"
                                     views:VariableTokenToolTips.IsEnabled="True"
                                     Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Add to" />
                            <ComboBox Width="160"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{x:Static vm:RequestNodeViewModel.ApiKeyLocationOptions}"
                                      SelectedItem="{Binding ApiKeyLocation, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   Visibility="{Binding IsAuthNone, Converter={StaticResource BoolToVis}}"
                                   Text="No authentication will be applied when sending." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Raw Request">
                <TextBox Margin="8"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Text="{Binding LastResponse.RawRequest, Mode=OneWay}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
