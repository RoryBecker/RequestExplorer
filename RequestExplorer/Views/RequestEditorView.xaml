<UserControl x:Class="RequestExplorer.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RequestExplorer.ViewModels.Nodes"
             xmlns:models="clr-namespace:RequestExplorer.Models"
             xmlns:gridHelpers="clr-namespace:RequestExplorer.Views.GridHelpers"
             xmlns:menuHelpers="clr-namespace:RequestExplorer.Views.MenuHelpers"
             xmlns:otherHelpers="clr-namespace:RequestExplorer.Views.OtherHelpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="KeyValueGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="gridHelpers:KeyValueGridSorting.SpareAwareSort" Value="True" />
            <Setter Property="gridHelpers:KeyValueGridClipboard.EnableRowClipboard" Value="True" />
            <Setter Property="gridHelpers:KeyValueGridReorder.EnableRowReorder" Value="True" />
            <Setter Property="menuHelpers:KeyValueGridVariableMenus.EnableMoveMenus" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.SelectionTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormFieldGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.SelectionTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyValueCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="otherHelpers:VariableTokenToolTips.IsEnabled" Value="True" />
        </Style>

        <Style x:Key="KeyValueCellTextPlain" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="KeyValueCellEdit" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="otherHelpers:VariableTokenToolTips.IsEnabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <CheckBox DockPanel.Dock="Right"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      Content="Opt out of auto run"
                      ToolTip="Skip this request when using Run Requests. Diagnose Requests still includes it."
                      IsChecked="{Binding OptOutOfAutoRun}" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.WarnBrush}"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                       Text="Unsaved changes *  (Ctrl+S to save)" />
            <TextBox x:Name="TitleBox"
                     MinWidth="200"
                     FontSize="16"
                     FontWeight="SemiBold"
                     BorderThickness="0,0,0,1"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=Explicit}" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Margin="0,0,8,0"
                      Height="32"
                      FontSize="13"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Left"
                      Padding="8,4,24,4"
                      ItemsSource="{x:Static vm:RequestNodeViewModel.VerbOptions}"
                      SelectedItem="{Binding Verb, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Padding="2,0"
                                   Foreground="{DynamicResource App.TextBrush}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <TextBox Grid.Column="1"
                     Height="32"
                     VerticalContentAlignment="Center"
                     otherHelpers:VariableTokenToolTips.IsEnabled="True"
                     menuHelpers:UrlExtractAsVariableMenu.IsEnabled="True"
                     menuHelpers:UrlReplaceWithVariableMenu.IsEnabled="True"
                     menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Send"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="Send request (Alt+X)"
                    Command="{Binding DataContext.SendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Grid.Column="3"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Cancel"
                    ToolTip="Cancel in-flight request"
                    Command="{Binding DataContext.CancelSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <DockPanel Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Margin="0,4,0,0"
                       LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarIconButton}"
                        Width="22"
                        Height="22"
                        Margin="0,0,4,0"
                        VerticalAlignment="Top"
                        ToolTip="Copy calculated URL"
                        Command="{Binding CopyResolvedAddressCommand}">
                    <TextBlock Style="{StaticResource ToolbarIconText}"
                               FontSize="12"
                               Text="&#xE8C8;" />
                </Button>
                <TextBlock MinHeight="22"
                           Padding="6,2"
                           FontSize="11"
                           IsHitTestVisible="True"
                           Background="Transparent"
                           Foreground="{DynamicResource App.MutedBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           ToolTip="URL with {{variables}} resolved from parent collection/folder scope; substituted values are bold"
                           menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                           otherHelpers:ResolvedTextHighlight.Spans="{Binding ResolvedAddressSpans, Mode=OneWay}" />
            </DockPanel>
        </Grid>

        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding DataContext.SelectedRequestTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Description" VerticalAlignment="Center" />
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE81E;"
                                   Margin="6,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasDefinedDescription, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <TextBox Margin="8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalContentAlignment="Top"
                         Padding="8,6"
                         FontSize="13"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Body" VerticalAlignment="Center" />
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE81E;"
                                   Margin="6,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasDefinedBody, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Text="Type" />
                        <RadioButton Content="Raw"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     GroupName="RequestBodyMode"
                                     IsChecked="{Binding IsBodyModeRaw, Mode=TwoWay}" />
                        <RadioButton Content="Form data"
                                     VerticalAlignment="Center"
                                     GroupName="RequestBodyMode"
                                     IsChecked="{Binding IsBodyModeFormData, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid>
                    <DockPanel Visibility="{Binding IsBodyModeRaw, Converter={StaticResource BoolToVis}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="Content-Type" />
                            <TextBox Width="220"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     otherHelpers:VariableTokenToolTips.IsEnabled="True"
                                     menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                                     Text="{Binding BodyContentType, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBox AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 otherHelpers:VariableTokenToolTips.IsEnabled="True"
                                 menuHelpers:JsonPathMenu.IsEnabled="True"
                                 menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                                 Text="{Binding BodyContent, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <DataGrid Style="{StaticResource FormFieldGrid}"
                              Visibility="{Binding IsBodyModeFormData, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding FormFields}"
                              CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On"
                                                    Width="44"
                                                    SortMemberPath="IsEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding HasKey}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Key"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"
                                                ElementStyle="{StaticResource KeyValueCellText}"
                                                EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                            <DataGridTemplateColumn Header="Type" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="4,0"
                                                   Text="{Binding Type}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}">
                                            <models:FormFieldType>Text</models:FormFieldType>
                                            <models:FormFieldType>File</models:FormFieldType>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Value" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock VerticalAlignment="Center"
                                                       Margin="4,0"
                                                       Text="{Binding Value}"
                                                       Visibility="{Binding IsTextType, Converter={StaticResource BoolToVis}}" />
                                            <DockPanel Visibility="{Binding IsFileType, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right"
                                                        Margin="6,0,0,0"
                                                        Padding="8,2"
                                                        Content="…"
                                                        ToolTip="Choose file"
                                                        Command="{Binding DataContext.ChooseFormFieldFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right"
                                                        Margin="6,0,0,0"
                                                        Padding="8,2"
                                                        Content="View"
                                                        ToolTip="Open the stored file"
                                                        IsEnabled="{Binding HasBase64}"
                                                        Command="{Binding DataContext.ViewFormFieldFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding FileDisplay}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsTextType, Converter={StaticResource BoolToVis}}"
                                                     otherHelpers:VariableTokenToolTips.IsEnabled="True"
                                                     menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True" />
                                            <DockPanel Visibility="{Binding IsFileType, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right"
                                                        Margin="6,0,0,0"
                                                        Padding="8,2"
                                                        Content="…"
                                                        ToolTip="Choose file"
                                                        Command="{Binding DataContext.ChooseFormFieldFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right"
                                                        Margin="6,0,0,0"
                                                        Padding="8,2"
                                                        Content="View"
                                                        ToolTip="Open the stored file"
                                                        IsEnabled="{Binding HasBase64}"
                                                        Command="{Binding DataContext.ViewFormFieldFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding FileDisplay}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header=""
                                                    Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TreeActionButton}"
                                                ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveFormFieldCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="✕" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Params" VerticalAlignment="Center" />
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE81E;"
                                   Margin="6,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasDefinedParams, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <DataGrid Style="{StaticResource KeyValueGrid}"
                          Margin="8"
                          ItemsSource="{Binding Params}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On"
                                                Width="44"
                                                SortMemberPath="IsEnabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding HasKey}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Key"
                                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            Width="2*"
                                            ElementStyle="{StaticResource KeyValueCellText}"
                                            EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                        <DataGridTemplateColumn Header=""
                                                Width="36"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-"
                                            Style="{StaticResource TreeActionButton}"
                                            ToolTip="Remove row"
                                            Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveParamCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Headers" VerticalAlignment="Center" />
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE81E;"
                                   Margin="6,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding HeadersTooltip}"
                                   Visibility="{Binding HasDefinedHeaders, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140" MinHeight="56" MaxHeight="480" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0"
                                   gridHelpers:CollapsibleGridRow.CollapseWhenHidden="True"
                                   Visibility="{Binding ShowInheritedHeadersGrid, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,4"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.MutedBrush}"
                                       Text="INHERITED" />
                            <DataGrid ItemsSource="{Binding InheritedHeaders}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource App.GridLineBrush}"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource App.BorderBrush}"
                                      RowHeight="28"
                                      ColumnHeaderHeight="26"
                                      MinHeight="40"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource App.SubtlePanelBrush}"
                                      Foreground="{DynamicResource App.MutedBrush}"
                                      gridHelpers:KeyValueGridClipboard.EnableRowClipboard="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key"
                                                        Binding="{Binding Key}"
                                                        Width="*"
                                                        MinWidth="60"
                                                        ElementStyle="{StaticResource KeyValueCellText}" />
                                    <DataGridTextColumn Header="Value"
                                                        Binding="{Binding HeaderValue}"
                                                        Width="2*"
                                                        MinWidth="80"
                                                        ElementStyle="{StaticResource KeyValueCellText}" />
                                    <DataGridTextColumn Header="From"
                                                        Binding="{Binding SourceName}"
                                                        Width="120"
                                                        MinWidth="60"
                                                        ElementStyle="{StaticResource KeyValueCellTextPlain}" />
                                    <DataGridTextColumn Header=""
                                                        Binding="{Binding StatusDisplay}"
                                                        Width="90"
                                                        MinWidth="48"
                                                        ElementStyle="{StaticResource KeyValueCellTextPlain}" />
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShadowed}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Row="1"
                                      Height="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Cursor="SizeNS"
                                      Background="{DynamicResource App.GridLineBrush}"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Rows"
                                      ShowsPreview="False"
                                      ToolTip="Drag to resize Inherited / Local"
                                      Panel.ZIndex="1"
                                      gridHelpers:CollapsibleGridRow.CollapseWhenHidden="True"
                                      Visibility="{Binding ShowInheritedHeadersGrid, Converter={StaticResource BoolToVis}}" />

                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,4,0,4"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.MutedBrush}"
                                       Text="LOCAL"
                                       Visibility="{Binding ShowInheritedHeadersGrid, Converter={StaticResource BoolToVis}}" />
                            <DataGrid Style="{StaticResource KeyValueGrid}"
                                      ItemsSource="{Binding Headers}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="On"
                                                            Width="44"
                                                            SortMemberPath="IsEnabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding HasKey}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Key"
                                                        Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"
                                                        ElementStyle="{StaticResource KeyValueCellText}"
                                                        EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                                    <DataGridTextColumn Header="Value"
                                                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="2*"
                                                        ElementStyle="{StaticResource KeyValueCellText}"
                                                        EditingElementStyle="{StaticResource KeyValueCellEdit}" />
                                    <DataGridTemplateColumn Header=""
                                                            Width="36"
                                                            CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="-"
                                                        Style="{StaticResource TreeActionButton}"
                                                        ToolTip="Remove row"
                                                        Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Auth" VerticalAlignment="Center" />
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE81E;"
                                   Margin="6,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasDefinedAuth, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Type" />
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Static vm:RequestNodeViewModel.AuthTypeOptions}"
                                  SelectedItem="{Binding AuthType, Mode=TwoWay}" />

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthBearer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Bearer token" />
                            <TextBox x:Name="BearerTokenBox"
                                     otherHelpers:VariableTokenToolTips.IsEnabled="True"
                                     menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                                     Text="{Binding BearerToken, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthBasic, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Username" />
                            <TextBox Margin="0,0,0,8"
                                     otherHelpers:VariableTokenToolTips.IsEnabled="True"
                                     menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                                     Text="{Binding BasicUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Password" />
                            <TextBox otherHelpers:VariableTokenToolTips.IsEnabled="True"
                                     menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                                     Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthApiKey, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key name" />
                            <TextBox Margin="0,0,0,8"
                                     otherHelpers:VariableTokenToolTips.IsEnabled="True"
                                     menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                                     Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key value" />
                            <TextBox Margin="0,0,0,8"
                                     otherHelpers:VariableTokenToolTips.IsEnabled="True"
                                     menuHelpers:VariableGoToDefinitionMenu.IsEnabled="True"
                                     Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Add to" />
                            <ComboBox Width="160"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{x:Static vm:RequestNodeViewModel.ApiKeyLocationOptions}"
                                      SelectedItem="{Binding ApiKeyLocation, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   Visibility="{Binding IsAuthNone, Converter={StaticResource BoolToVis}}"
                                   Text="No authentication will be applied when sending." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Raw Request">
                <TextBox Margin="8"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Text="{Binding LastResponse.RawRequest, Mode=OneWay}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
