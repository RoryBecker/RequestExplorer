<UserControl x:Class="RequestExplorer.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RequestExplorer.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title + dirty banner -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBox DockPanel.Dock="Left"
                     MinWidth="200"
                     MaxWidth="480"
                     FontSize="16"
                     FontWeight="SemiBold"
                     BorderThickness="0,0,0,1"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FFB45309"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                       Text="Unsaved changes *  (Ctrl+S to save)" />
        </DockPanel>

        <!-- Verb + URL + Send -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Margin="0,0,8,0"
                      Height="32"
                      ItemsSource="{x:Static vm:RequestNodeViewModel.VerbOptions}"
                      SelectedItem="{Binding Verb, Mode=TwoWay}" />

            <TextBox Grid.Column="1"
                     Height="32"
                     VerticalContentAlignment="Center"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Send"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="Send request (Ctrl+Enter)"
                    Command="{Binding DataContext.SendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Grid.Column="3"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Cancel"
                    ToolTip="Cancel in-flight request"
                    Command="{Binding DataContext.CancelSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>

        <TabControl Grid.Row="3">
            <TabItem Header="Params">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button Content="Add"
                                Padding="12,4"
                                Command="{Binding AddParamCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Params}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#FFDDDDDD">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On"
                                                    Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="40" />
                            <DataGridTextColumn Header="Key"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*" />
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Padding="6,2"
                                                Command="{Binding DataContext.RemoveParamCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Headers">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button Content="Add"
                                Padding="12,4"
                                Command="{Binding AddHeaderCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Headers}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#FFDDDDDD">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On"
                                                    Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="40" />
                            <DataGridTextColumn Header="Key"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*" />
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Padding="6,2"
                                                Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Auth">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Type" />
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Static vm:RequestNodeViewModel.AuthTypeOptions}"
                                  SelectedItem="{Binding AuthType, Mode=TwoWay}" />

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthBearer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Bearer token" />
                            <TextBox Text="{Binding BearerToken, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthBasic, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Username" />
                            <TextBox Margin="0,0,0,8"
                                     Text="{Binding BasicUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Password" />
                            <TextBox Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsAuthApiKey, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key name" />
                            <TextBox Margin="0,0,0,8"
                                     Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key value" />
                            <TextBox Margin="0,0,0,8"
                                     Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Add to" />
                            <ComboBox Width="160"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{x:Static vm:RequestNodeViewModel.ApiKeyLocationOptions}"
                                      SelectedItem="{Binding ApiKeyLocation, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   Foreground="#FF888888"
                                   Visibility="{Binding IsAuthNone, Converter={StaticResource BoolToVis}}"
                                   Text="No authentication will be applied when sending." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Body">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="Content-Type" />
                        <TextBox Width="220"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding BodyContentType, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBox AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Text="{Binding BodyContent, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
