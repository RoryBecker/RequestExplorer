<UserControl x:Class="RequestExplorer.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RequestExplorer.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding Name}" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="#FF999999"
                       FontSize="11"
                       Text="Read-only preview · editing in Phase 3" />
        </DockPanel>

        <!-- Verb + URL + Send -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Margin="0,0,8,0"
                      Height="32"
                      IsEnabled="False"
                      SelectedItem="{Binding Verb, Mode=OneWay}">
                <models:HttpVerb>GET</models:HttpVerb>
                <models:HttpVerb>POST</models:HttpVerb>
                <models:HttpVerb>PUT</models:HttpVerb>
                <models:HttpVerb>PATCH</models:HttpVerb>
                <models:HttpVerb>DELETE</models:HttpVerb>
                <models:HttpVerb>HEAD</models:HttpVerb>
                <models:HttpVerb>OPTIONS</models:HttpVerb>
            </ComboBox>

            <TextBox Grid.Column="1"
                     Height="32"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Text="{Binding Address, Mode=OneWay}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Width="88"
                    Height="32"
                    Content="Send"
                    IsEnabled="False"
                    ToolTip="Send will be available in Phase 5" />
        </Grid>

        <!-- Section stubs -->
        <TabControl Grid.Row="2">
            <TabItem Header="Params">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               Foreground="#FF888888"
                               Text="Query parameters (editable in Phase 3)" />
                    <ListView ItemsSource="{Binding Model.Params}"
                              BorderThickness="1"
                              BorderBrush="#FFDDDDDD">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="On" Width="40"
                                                DisplayMemberBinding="{Binding IsEnabled}" />
                                <GridViewColumn Header="Key" Width="160"
                                                DisplayMemberBinding="{Binding Key}" />
                                <GridViewColumn Header="Value" Width="280"
                                                DisplayMemberBinding="{Binding Value}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Headers">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               Foreground="#FF888888"
                               Text="Headers (editable in Phase 3)" />
                    <ListView ItemsSource="{Binding Model.Headers}"
                              BorderThickness="1"
                              BorderBrush="#FFDDDDDD">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="On" Width="40"
                                                DisplayMemberBinding="{Binding IsEnabled}" />
                                <GridViewColumn Header="Key" Width="160"
                                                DisplayMemberBinding="{Binding Key}" />
                                <GridViewColumn Header="Value" Width="280"
                                                DisplayMemberBinding="{Binding Value}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Auth">
                <StackPanel Margin="12" Orientation="Vertical">
                    <TextBlock Foreground="#FF888888" Margin="0,0,0,12"
                               Text="Authentication (editable in Phase 3)" />
                    <TextBlock>
                        <Run FontWeight="SemiBold" Text="Type: " />
                        <Run Text="{Binding Model.Authentication.Type, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0">
                        <Run FontWeight="SemiBold" Text="Bearer: " />
                        <Run Text="{Binding Model.Authentication.BearerToken, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0">
                        <Run FontWeight="SemiBold" Text="Basic user: " />
                        <Run Text="{Binding Model.Authentication.BasicUsername, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0">
                        <Run FontWeight="SemiBold" Text="API key: " />
                        <Run Text="{Binding Model.Authentication.ApiKeyName, Mode=OneWay}" />
                        <Run Text=" = " />
                        <Run Text="{Binding Model.Authentication.ApiKeyValue, Mode=OneWay}" />
                        <Run Text=" (" />
                        <Run Text="{Binding Model.Authentication.ApiKeyLocation, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <TabItem Header="Body">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               Foreground="#FF888888">
                        <Run Text="Body · Content-Type: " />
                        <Run Text="{Binding Model.Body.ContentType, Mode=OneWay}" />
                        <Run Text=" (editable in Phase 3)" />
                    </TextBlock>
                    <TextBox IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Text="{Binding Model.Body.Content, Mode=OneWay}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
