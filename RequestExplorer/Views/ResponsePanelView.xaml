<UserControl x:Class="RequestExplorer.Views.ResponsePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             DataContextChanged="ResponsePanelView_OnDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ResponseTabRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="{DynamicResource App.BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3,3,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.PanelBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FloodRawTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="{DynamicResource App.InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource App.TextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,2"
                   LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0">
                <Run Text="Status " Foreground="{DynamicResource App.MutedBrush}" />
                <Run Text="{Binding StatusDisplay, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0">
                <Run Text="Time " Foreground="{DynamicResource App.MutedBrush}" />
                <Run Text="{Binding ElapsedDisplay, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource App.WarnBrush}"
                       Text="{Binding SizeWarning}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SizeWarning}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button DockPanel.Dock="Right"
                    Padding="10,2"
                    VerticalAlignment="Center"
                    Content="Save body…"
                    ToolTip="Save the response body to a file"
                    Command="{Binding SaveBodyCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanSaveBody}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDownloadable}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>

        <StackPanel x:Name="TabStrip"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,4">
            <RadioButton x:Name="TabBody"
                         GroupName="ResponsePanelTabs"
                         Content="Body"
                         Style="{StaticResource ResponseTabRadio}"
                         IsChecked="True"
                         Checked="Tab_OnChecked" />
            <RadioButton x:Name="TabHeaders"
                         GroupName="ResponsePanelTabs"
                         Content="Headers"
                         Style="{StaticResource ResponseTabRadio}"
                         Checked="Tab_OnChecked" />
            <RadioButton x:Name="TabCookies"
                         GroupName="ResponsePanelTabs"
                         Content="Cookies"
                         Style="{StaticResource ResponseTabRadio}"
                         Checked="Tab_OnChecked" />
            <RadioButton x:Name="TabRawResponse"
                         GroupName="ResponsePanelTabs"
                         Content="Raw Response"
                         Style="{StaticResource ResponseTabRadio}"
                         Checked="Tab_OnChecked" />
            <RadioButton x:Name="TabTiming"
                         GroupName="ResponsePanelTabs"
                         Content="Timing"
                         Style="{StaticResource ResponseTabRadio}"
                         Checked="Tab_OnChecked" />
            <RadioButton x:Name="TabExpectations"
                         GroupName="ResponsePanelTabs"
                         Content="Expectations"
                         Style="{StaticResource ResponseTabRadio}"
                         Checked="Tab_OnChecked" />
        </StackPanel>

        <!-- Star row: always consumes leftover height from the response grid row. -->
        <Grid x:Name="ContentHost" Grid.Row="2">
            <TextBlock x:Name="EmptyMessage"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource App.MutedBrush}"
                       Text="No response yet. Press Send to run this request." />

            <DockPanel x:Name="BodyPanel" LastChildFill="True">
                <DockPanel DockPanel.Dock="Top"
                           Margin="0,0,0,4"
                           LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Find"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource App.MutedBrush}" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="4,0,0,0">
                        <Button Padding="8,2"
                                Margin="0,0,2,0"
                                ToolTip="Previous match"
                                Command="{Binding FindPreviousBodyMatchCommand}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70E;" />
                        </Button>
                        <Button Padding="8,2"
                                ToolTip="Next match"
                                Command="{Binding FindNextBodyMatchCommand}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" />
                        </Button>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               MinWidth="72"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource App.MutedBrush}"
                               Text="{Binding BodySearchStatus, Mode=OneWay}" />
                    <TextBox VerticalContentAlignment="Center"
                             Text="{Binding BodySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="BodySearchBox_OnPreviewKeyDown" />
                </DockPanel>
                <TextBox x:Name="BodyTextBox"
                         Style="{StaticResource FloodRawTextBox}"
                         IsInactiveSelectionHighlightEnabled="True"
                         Text="{Binding BodyText, Mode=OneWay}" />
            </DockPanel>

            <ListView x:Name="HeadersPanel"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ItemsSource="{Binding Headers}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Value" Width="480" DisplayMemberBinding="{Binding Value}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <ListView x:Name="CookiesPanel"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ItemsSource="{Binding Cookies}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   Margin="0,2" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBox x:Name="RawResponseTextBox"
                     Style="{StaticResource FloodRawTextBox}"
                     Text="{Binding RawResponse, Mode=OneWay}" />

            <ScrollViewer x:Name="TimingPanel"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <StackPanel Margin="8,8,8,0" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,8">
                        <Run FontWeight="SemiBold" Text="Total: " />
                        <Run Text="{Binding TotalTimingDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,8">
                        <Run FontWeight="SemiBold" Text="Time to headers: " />
                        <Run Text="{Binding TimeToHeadersDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,8">
                        <Run FontWeight="SemiBold" Text="Body download: " />
                        <Run Text="{Binding BodyReadDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource App.MutedBrush}"
                               Text="DNS / connect / TLS timings are not available via HttpClient in this build." />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ExpectationsPanel"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <StackPanel Margin="8,8,8,0"
                            Orientation="Vertical"
                            DataContext="{Binding DataContext.SelectedRequest, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource App.MutedBrush}"
                               Text="Define what a successful response looks like for this request. Run All marks Met only when every enabled check passes. Status code is always checked; body and timing are optional. With Contains checked, the body must include the expected text rather than match it exactly." />

                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Text="Expected status code" />
                        <TextBox DockPanel.Dock="Left"
                                 Width="72"
                                 VerticalContentAlignment="Center"
                                 Padding="4,2"
                                 ToolTip="HTTP status code expected when this request succeeds (default 200)"
                                 Text="{Binding ExpectedStatusCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>

                    <Border Height="1"
                            Margin="0,0,0,12"
                            Background="{DynamicResource App.BorderBrush}"
                            SnapsToDevicePixels="True" />

                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                        <CheckBox DockPanel.Dock="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Content="Timing (max total ms)"
                                  IsChecked="{Binding ExpectTimingEnabled, Mode=TwoWay}" />
                        <Button DockPanel.Dock="Right"
                                Padding="8,2"
                                Margin="8,0,0,0"
                                Content="Copy from last run"
                                ToolTip="Copy the last successful total time and enable this check"
                                Command="{Binding CopyExpectedTimingFromLastRunCommand}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <TextBox DockPanel.Dock="Left"
                                 Width="100"
                                 VerticalContentAlignment="Center"
                                 Padding="4,2"
                                 IsEnabled="{Binding ExpectTimingEnabled}"
                                 ToolTip="Response total time must be at most this many milliseconds"
                                 Text="{Binding ExpectedTimingMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   Text="ms" />
                    </DockPanel>

                    <Border Height="1"
                            Margin="0,0,0,12"
                            Background="{DynamicResource App.BorderBrush}"
                            SnapsToDevicePixels="True" />

                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Content="Body content"
                                  IsChecked="{Binding ExpectBodyEnabled, Mode=TwoWay}" />
                        <CheckBox DockPanel.Dock="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Content="Contains"
                                  IsEnabled="{Binding ExpectBodyEnabled}"
                                  IsChecked="{Binding ExpectBodyContains, Mode=TwoWay}"
                                  ToolTip="When checked, the response body must contain this text; otherwise it must match exactly" />
                        <Button DockPanel.Dock="Right"
                                Padding="8,2"
                                Margin="8,0,0,0"
                                Content="Copy from last run"
                                ToolTip="Copy the last successful response body and enable this check"
                                Command="{Binding CopyExpectedBodyFromLastRunCommand}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4"
                               LastChildFill="True"
                               IsEnabled="{Binding ExpectBodyEnabled}">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Find"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource App.MutedBrush}" />
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="4,0,0,0">
                            <Button Padding="8,2"
                                    Margin="0,0,2,0"
                                    ToolTip="Previous match"
                                    Click="ExpectedBodyFindPrevious_OnClick">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70E;" />
                            </Button>
                            <Button Padding="8,2"
                                    ToolTip="Next match"
                                    Click="ExpectedBodyFindNext_OnClick">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="ExpectedBodyFindStatusText"
                                   DockPanel.Dock="Right"
                                   MinWidth="72"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.MutedBrush}" />
                        <TextBox x:Name="ExpectedBodyFindBox"
                                 VerticalContentAlignment="Center"
                                 TextChanged="ExpectedBodyFindBox_OnTextChanged" />
                    </DockPanel>
                    <TextBox x:Name="ExpectedBodyTextBox"
                             MinHeight="120"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsEnabled="{Binding ExpectBodyEnabled}"
                             Text="{Binding ExpectedBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="ExpectedBodyTextBox_OnTextChanged">
                        <TextBox.ContextMenu>
                            <ContextMenu Opened="ExpectedBodyMenu_OnOpened">
                                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" />
                                <MenuItem Header="Cop_y" Command="ApplicationCommands.Copy" />
                                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" />
                                <Separator />
                                <MenuItem x:Name="KeepExpectedBodySelectionMenuItem"
                                          Header="Crop to _Selection"
                                          Click="KeepExpectedBodySelection_OnClick"
                                          ToolTip="Replace the expected body with only the highlighted text" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
