<Window x:Class="RequestExplorer.Views.RunAllResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run All Requests"
        Height="480"
        Width="860"
        MinHeight="320"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.PanelBrush}"
        Foreground="{DynamicResource App.TextBrush}">
    <Window.Resources>
        <Style x:Key="MetCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF15803D" />
            <Setter Property="ToolTip" Value="Expectation met" />
            <Style.Triggers>
                <Trigger Property="Text" Value="✗">
                    <Setter Property="Foreground" Value="#FFDC2626" />
                    <Setter Property="ToolTip" Value="Expectation not met" />
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpectationGlyphCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ExpectationResponseCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusExpectationMet}" Value="True">
                    <Setter Property="Background" Value="#FF16A34A" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStatusExpectationFailed}" Value="True">
                    <Setter Property="Background" Value="#FFDC2626" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsStatusExpectationMet}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FF15803D" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsStatusExpectationFailed}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFB91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpectationResponseTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusExpectationMet}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStatusExpectationFailed}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpectationBodyCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBodyExpectationMet}" Value="True">
                    <Setter Property="Background" Value="#FF16A34A" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBodyExpectationFailed}" Value="True">
                    <Setter Property="Background" Value="#FFDC2626" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBodyExpectationMet}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FF15803D" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBodyExpectationFailed}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFB91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpectationTimingCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTimingExpectationMet}" Value="True">
                    <Setter Property="Background" Value="#FF16A34A" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTimingExpectationFailed}" Value="True">
                    <Setter Property="Background" Value="#FFDC2626" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsTimingExpectationMet}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FF15803D" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsTimingExpectationFailed}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFB91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpectationTimingTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTimingExpectationMet}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTimingExpectationFailed}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RunAllRowContextMenu" x:Shared="False">
            <MenuItem Header="Rerun" Click="RerunRowMenu_Click" />
        </ContextMenu>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Threads"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource App.MutedBrush}" />
                <ComboBox x:Name="MaxThreadsBox"
                          Width="52"
                          VerticalAlignment="Center"
                          ToolTip="Maximum number of requests to run at the same time (1–10)" />
                <CheckBox x:Name="CheckTimingBox"
                          Content="Check Timing"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          ToolTip="When checked, request timing expectations are included in Met" />
            </StackPanel>
            <TextBlock x:Name="SummaryText"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource App.MutedBrush}" />
        </DockPanel>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource App.GridLineBrush}"
                  BorderBrush="{DynamicResource App.BorderBrush}"
                  BorderThickness="1"
                  RowHeight="28"
                  ColumnHeaderHeight="28"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="ResultsGrid_OnMouseDoubleClick"
                  ContextMenuOpening="ResultsGrid_OnContextMenuOpening">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding HierarchyPath}" />
                    <Setter Property="ContextMenu" Value="{StaticResource RunAllRowContextMenu}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Request"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name"
                                    Width="1.4*" />
                <DataGridTextColumn Header="Hierarchy"
                                    Binding="{Binding HierarchyDisplay}"
                                    SortMemberPath="HierarchyDisplay"
                                    Width="2*" />
                <DataGridTextColumn Header="Response"
                                    Binding="{Binding StatusDisplay}"
                                    SortMemberPath="StatusDisplay"
                                    Width="*"
                                    CellStyle="{StaticResource ExpectationResponseCellStyle}"
                                    ElementStyle="{StaticResource ExpectationResponseTextStyle}" />
                <DataGridTextColumn Header="Body"
                                    Binding="{Binding BodyDisplay}"
                                    SortMemberPath="BodyDisplay"
                                    Width="48"
                                    CellStyle="{StaticResource ExpectationBodyCellStyle}"
                                    ElementStyle="{StaticResource ExpectationGlyphCellStyle}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Body expectation match (blank when body check is off)" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding ElapsedDisplay}"
                                    SortMemberPath="ElapsedMilliseconds"
                                    Width="80"
                                    CellStyle="{StaticResource ExpectationTimingCellStyle}"
                                    ElementStyle="{StaticResource ExpectationTimingTextStyle}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Click to cycle: tree order → largest first → smallest first" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Met"
                                    Binding="{Binding MetDisplay}"
                                    SortMemberPath="MetDisplay"
                                    Width="48"
                                    ElementStyle="{StaticResource MetCellStyle}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ToolTip" Value="Overall expectations — click to sort (tree order → unmet first → met first)" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource App.MutedBrush}"
                   Text="Hover a row for its full path. Double-click to select it. Click a column header to cycle sort (tree order → A–Z / largest → Z–A / smallest)." />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="RerunButton"
                    Content="Rerun"
                    Width="88"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    IsEnabled="False"
                    Click="Rerun_Click" />
            <Button x:Name="CancelButton"
                    Content="Stop Remaining"
                    MinWidth="120"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="88"
                    IsEnabled="False"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
