<Window x:Class="RequestExplorer.Views.RunAllResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run All Requests"
        Height="480"
        Width="720"
        MinHeight="320"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource App.PanelBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource App.MutedBrush}" />

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FFEEEEEE"
                  BorderBrush="{StaticResource App.BorderBrush}"
                  BorderThickness="1"
                  RowHeight="28"
                  ColumnHeaderHeight="28"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Request"
                                    Binding="{Binding Name}"
                                    Width="2*" />
                <DataGridTextColumn Header="Response"
                                    Binding="{Binding StatusDisplay}"
                                    Width="*" />
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding ElapsedDisplay}"
                                    Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="Stop Remaining"
                    MinWidth="120"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="88"
                    IsEnabled="False"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
