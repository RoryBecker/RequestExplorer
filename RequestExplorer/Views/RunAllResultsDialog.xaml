<Window x:Class="RequestExplorer.Views.RunAllResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run All Requests"
        Height="480"
        Width="860"
        MinHeight="320"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource App.PanelBrush}">
    <Window.Resources>
        <Style x:Key="MetCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF15803D" />
            <Setter Property="ToolTip" Value="Expectation met" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource App.MutedBrush}" />

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FFEEEEEE"
                  BorderBrush="{StaticResource App.BorderBrush}"
                  BorderThickness="1"
                  RowHeight="28"
                  ColumnHeaderHeight="28"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="ResultsGrid_OnMouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding HierarchyPath}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hierarchy"
                                    Binding="{Binding HierarchyDisplay}"
                                    SortMemberPath="HierarchyDisplay"
                                    Width="2*" />
                <DataGridTextColumn Header="Request"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name"
                                    Width="1.4*" />
                <DataGridTextColumn Header="Response"
                                    Binding="{Binding StatusDisplay}"
                                    SortMemberPath="StatusDisplay"
                                    Width="*" />
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding ElapsedDisplay}"
                                    SortMemberPath="ElapsedMilliseconds"
                                    Width="80">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ToolTip" Value="Click to cycle: tree order → largest first → smallest first" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Met"
                                    Binding="{Binding MetDisplay}"
                                    SortMemberPath="MetDisplay"
                                    Width="48"
                                    ElementStyle="{StaticResource MetCellStyle}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ToolTip" Value="Expectation met — click to sort (tree order → unmet first → met first)" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Foreground="{StaticResource App.MutedBrush}"
                   Text="Hover a row for its full path. Double-click to select it. Click a column header to cycle sort (tree order → A–Z / largest → Z–A / smallest)." />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="Stop Remaining"
                    MinWidth="120"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="88"
                    IsEnabled="False"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
