<Window x:Class="RequestExplorer.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460"
        Height="580"
        MinWidth="380"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource App.PanelBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Request timeout"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <CheckBox x:Name="DevModeCheck"
                                  Content="Dev mode (ignore timeout)"
                                  Margin="0,0,0,12"
                                  Checked="DevModeCheck_OnChanged"
                                  Unchecked="DevModeCheck_OnChanged" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Width="140"
                                       Text="Timeout (seconds)" />
                            <TextBox x:Name="TimeoutBox"
                                     Width="80"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>

                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Default is 30 seconds. Dev mode uses an infinite timeout; Cancel still stops an in-flight send." />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Variables"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Width="140"
                                       Text="Max nesting depth" />
                            <TextBox x:Name="NestingDepthBox"
                                     Width="80"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>

                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="When a variable's value contains {{name}}, lookup restarts at the request and walks up the tree. Default is 10 (1–50). Deeper chains abort and show in Diagnose." />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Navigation"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <CheckBox x:Name="MouseTreeNavCheck"
                                  Content="Mouse back/forward buttons navigate the tree"
                                  Margin="0,0,0,4" />

                        <TextBlock Margin="0,0,0,0"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Uses the 4th and 5th mouse buttons (browser-style) to move through selected nodes. Toolbar Back/Forward always work." />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Backups"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <CheckBox x:Name="BackupOnStartupCheck"
                                  Content="Backup on startup"
                                  Margin="0,0,0,12" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Width="140"
                                       Text="Keep last (N)" />
                            <TextBox x:Name="RetentionBox"
                                     Width="80"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>

                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Backups are zip archives under the backups folder. Retention is 1–100 (default 15). Startup backup runs in the background after the window opens." />

                        <TextBlock x:Name="BackupsPathBlock"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Experimental">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Experimental features"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock Margin="0,0,0,16"
                                   Foreground="{DynamicResource App.MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="These options are off by default. They may change or be removed." />

                        <CheckBox x:Name="DirtySaveCheck"
                                  Content="Dirty Save"
                                  Margin="0,0,0,8" />

                        <TextBlock Foreground="{DynamicResource App.MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="When enabled, unsaved collections and undo history can be restored on the next launch. A Dirty Save button appears when you close with unsaved changes." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="88"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_OnClick" />
            <Button Content="OK"
                    Width="88"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Click="Ok_OnClick" />
        </StackPanel>
    </Grid>
</Window>
