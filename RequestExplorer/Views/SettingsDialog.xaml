<Window x:Class="RequestExplorer.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420"
        Height="260"
        MinWidth="360"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource App.PanelBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Request timeout"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <CheckBox x:Name="DevModeCheck"
                      Content="Dev mode (ignore timeout)"
                      Margin="0,0,0,12"
                      Checked="DevModeCheck_OnChanged"
                      Unchecked="DevModeCheck_OnChanged" />

            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Width="140"
                           Text="Timeout (seconds)" />
                <TextBox x:Name="TimeoutBox"
                         Width="80"
                         HorizontalAlignment="Left"
                         VerticalContentAlignment="Center" />
            </DockPanel>

            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource App.MutedBrush}"
                       TextWrapping="Wrap"
                       Text="Default is 30 seconds. Dev mode uses an infinite timeout; Cancel still stops an in-flight send." />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="88"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_OnClick" />
            <Button Content="OK"
                    Width="88"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Click="Ok_OnClick" />
        </StackPanel>
    </Grid>
</Window>
